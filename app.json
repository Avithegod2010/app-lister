{
  "expo": {
    "name": "App Lister",
    "slug": "app-lister",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "applister",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.avithegod2010.applister",
      "versionCode": 1,
      "permissions": [
        "QUERY_ALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#3A55E0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3A55E0",
          "dark": {
            "backgroundColor": "#111536"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cde1e3f3-614c-4287-970d-09dc0c07213a"
      }
    },
    "owner": "avithegod-team"
  }
}
